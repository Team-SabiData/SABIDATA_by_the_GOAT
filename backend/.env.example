# =============================================================================
# SabiData backend — configuration d'environnement
# Chargé automatiquement par `npm run dev` (--env-file-if-exists=.env).
# Ce fichier est gitignoré : les secrets réels ne partent jamais dans git.
# =============================================================================

# ── Auth (JWT) ──────────────────────────────────────────────────────────────
# Secret de signature des tokens. OBLIGATOIRE hors dev (sinon fallback
# 'dev-secret-change-me'). Générer avec : openssl rand -hex 32
JWT_SECRET=GENERE_AVEC_openssl_rand_-hex_32

# ── Base de données ─────────────────────────────────────────────────────────
# Local : DATABASE=pg → PGlite (Postgres WASM en mémoire, schéma auto-appliqué).
# ⚠ Les données sont perdues à chaque redémarrage — parfait pour tester,
# pas pour conserver des comptes.
DATABASE=pg

# Prod test (Neon) : décommenter et coller l'URL depuis console.neon.tech
# (elle inclut déjà ?sslmode=require). Prend le dessus sur DATABASE=pg.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/sabidata?sslmode=require

# ── Stockage audio ──────────────────────────────────────────────────────────
# Local : filesystem (défaut). Les blobs vont dans backend/var/audio/.
AUDIO_DIR=var/audio

# Prod test (Cloudflare R2) : décommenter les 4 lignes S3_*.
# Dashboard R2 → créer un bucket, puis "Manage R2 API Tokens" → jeton
# Object Read & Write ; ACCOUNT_ID est visible dans l'URL du dashboard.
# S3_BUCKET=sabi-audio
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=REMPLACE
# S3_SECRET_ACCESS_KEY=REMPLACE
# S3_REGION=auto          # (défaut : auto — correct pour R2)
# S3_PREFIX=clips/        # (optionnel : préfixe des clés dans le bucket)

# ── Vonage (Nexmo) SMS ──────────────────────────────────────────────────────
# Récupère ces valeurs sur https://dashboard.nexmo.com → API Settings
VONAGE_API_KEY=REMPLACE_PAR_TA_CLE
VONAGE_API_SECRET=REMPLACE_PAR_TON_SECRET

# Numéro expéditeur affiché (ou nom alphanumérique si autorisé par Vonage)
# Exemples : "SabiData" ou un numéro loué +1234567890
VONAGE_FROM=SabiData

# Mettre "true" en production pour envoyer les vrais SMS.
# En DEV le code reste "0000" et aucun SMS n'est envoyé.
SMS_ENABLED=false
